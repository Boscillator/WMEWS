# Obtain this from the data-collection root:
# tofu -chdir=terraform/data-collection output -raw raw_data_bucket_name
raw_data_bucket_name = "wmews-raw-data-12345678"

# AWS Budgets sends a confirmation email after deployment.
budget_alert_email = "you@example.com"

# IAM user or role ARN permitted to assume the restricted Studio access role.
studio_access_principal_arn = "arn:aws:iam::123456789012:role/YourOperatorRole"

# If the account has no default VPC, set both values below.
# vpc_id     = "vpc-0123456789abcdef0"
# subnet_ids = ["subnet-0123456789abcdef0"]
